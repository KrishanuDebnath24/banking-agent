# Copy to .env and fill in. Never commit .env.

OBP_BASE_URL=https://apisandbox.openbankproject.com
OBP_API_VERSION=v5.0.0
OBP_CONSUMER_KEY=your-consumer-key
OBP_CONSUMER_SECRET=your-consumer-secret

# Bank the sandbox customers belong to (check in the API Explorer)
OBP_BANK_ID=gh.29.uk

# Customer logins from the OBP sandbox wiki (Customer logins section)
CUSTOMER_A_USERNAME=robert.uk.29@example.com
CUSTOMER_A_PASSWORD=
CUSTOMER_B_USERNAME=susan.uk.29@example.com
CUSTOMER_B_PASSWORD=

# Largest single transfer the scripts make; bigger ones need a second approver in OBP
OBP_MAX_TRANSFER=800

# ---- Phase 1 agent ----
# Pick ONE model option.

# Amazon Bedrock from Ireland (recommended): Claude Haiku 5.5 via the EU inference profile,
# so requests stay in EU regions. Cheap and strong at tool calling.
MODEL=bedrock_converse:eu.anthropic.claude-haiku-5-5
AWS_REGION=eu-west-1
# Alternatives on Bedrock:
# MODEL=bedrock_converse:eu.anthropic.claude-sonnet-5-5   (stronger, ~20x the price; check the ID in the console)
# MODEL=bedrock_converse:qwen.qwen3-32b-v1:0              (open model, in-region in eu-west-1)
# Credentials: uncomment and paste a Bedrock API key, OR leave commented and run "aws configure"
# AWS_BEARER_TOKEN_BEDROCK=

# Self-hosted Ollama on AWS (model must support tools)
# MODEL=ollama:qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434   # via SSH tunnel; or the instance's private IP in your VPC
# OLLAMA_NUM_CTX=16384

# Anthropic API directly (same Claude models, no AWS needed)
# MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-api...          # console.anthropic.com > API Keys; no quotes or spaces

# LangSmith tracing (smith.langchain.com -> Settings -> API keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=banking-agent-demo

# ---- Phase 2 multi-agent (defaults shown; only change if you move the servers) ----
# MCP_ACCOUNTS_URL=http://127.0.0.1:8101/mcp
# MCP_TRANSACTIONS_URL=http://127.0.0.1:8102/mcp
# MCP_SERVICE_URL=http://127.0.0.1:8103/mcp
# SESSION_DB=sessions.db                  # conversations + pending confirmations (SQLite)
# OBP_FAKE=1                              # use the built-in fake bank instead of OBP (demo/offline)

# ---- Security codes (one-time passcodes) ----
# Address changes always need a code; transfers need one from this amount up (off = never)
OTP_TRANSFER_THRESHOLD=500
# The demo customers' @example.com emails can't receive mail, so codes go to your own inbox
OTP_EMAIL_TO=
# console = print codes in the MCP server window (no setup); smtp = really email them
EMAIL_BACKEND=console
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_FROM=                             # defaults to SMTP_USER
# VERIFY_URL=http://127.0.0.1:8104        # security code service, started by mcp_servers.run
# OTP_DB=verification.db                  # pending and used codes (hashed, never the code itself)

# ---- Phase 3: guardrails, costs, evals ----
# Amazon Bedrock guardrail (optional; without it only the built-in rules run).
# Create it with:  python -m scripts.setup_guardrail --test   (then paste the lines it prints)
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=1
# GUARDRAIL_REGION=eu-west-1
# GUARDRAIL_MODE=shadow                   # shadow = log what it would block; enforce = block
# GUARDRAIL_ON_ERROR=open                 # open = carry on if Bedrock is down; closed = refuse
# LANGSMITH_HIDE_CONTENT=false            # true = send timings only, no message text, to LangSmith
# TELEMETRY_DB=telemetry.db               # cost ledger; "off" to disable
# COST_ALERT_DAILY_USD=1.00               # scripts.cost_report warns above this
# EVAL_JUDGE_MODEL=anthropic:claude-sonnet-5-5
# EVAL_MIN_PASS_RATE=0.90
# EVAL_MAX_AVG_COST_USD=0.01
# EVAL_MAX_P95_SECONDS=45

# ---- Phase 4: web chat (python -m api) ----
# AUTH_MODE=dev                           # dev = pick a demo customer; cognito = the bank's sign-in (AWS)
# API_HOST=127.0.0.1
# PORT=8000
# COOKIE_SECURE=0                         # 1 behind HTTPS (set automatically on AWS)
# API_RATE_LIMIT_PER_MIN=30               # requests per signed-in session

# ---- Phase 4, step 2: Postgres and Docker ----
# Set to keep every record (conversations, codes, service requests, costs) in Postgres instead of
# SQLite files. Docker sets it for its own containers; this line is for Python running on your PC
# against  docker compose up -d db
# DATABASE_URL=postgresql://bank:bank-local-only@localhost:5432/bank
# POSTGRES_PASSWORD=bank-local-only        # password docker compose gives the local database
# POSTGRES_PORT=5432                       # change if another Postgres already uses 5432 (and in DATABASE_URL)
# SERVICE_REQUESTS_DB=service_requests.db  # service requests (SQLite, without DATABASE_URL)
# MCP_HOST=127.0.0.1                       # where the bank servers listen (Docker uses 0.0.0.0)

# ---- Phase 4, step 3: AWS (python code in infra/, run with the cdk command) ----
# AWS_REGION above is where everything goes (eu-west-1 = Ireland).
BUDGET_EMAIL=                             # where the budget alerts go
BUDGET_USD=25                             # monthly limit, counted before credits
# ALLOWED_CIDR=81.2.3.4/32                # your address, the only one allowed to open the app until
#                                         # sign-in and https arrive. Find it: (Invoke-RestMethod checkip.amazonaws.com)
